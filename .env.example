# Supabase Configuration
# Copy to .env.local and fill in your project credentials

# Public (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service mode: true = mock/localStorage (default until backend phases complete)
# false = production Supabase services (requires configured Supabase + implemented phases)
NEXT_PUBLIC_USE_MOCK_SERVICES=true

# Server-only — NEVER prefix with NEXT_PUBLIC_
# SUPABASE_SERVICE_ROLE_KEY=
# OPENAI_API_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
